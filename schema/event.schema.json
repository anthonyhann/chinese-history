{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chinese-history.org/schema/event.schema.json",
  "title": "Event 历史事件",
  "description": "事件实体。id 规则：event.{dynasty_slug}.{slug}；participants 引用 person id 并标注角色",
  "type": "object",
  "required": ["id", "uuid", "name", "category", "time", "description", "sources", "_meta"],
  "properties": {
    "id": {"type": "string"},
    "uuid": {"type": "string"},
    "name": {"type": "string"},
    "name_traditional": {"type": "string"},
    "category": {"type": "array", "minItems": 1, "items": {"type": "string"},
                 "description": "如 war / reform / coup / uprising / policy / diplomacy / construction"},
    "time": {"$ref": "common.schema.json#/definitions/timeRange"},
    "place": {"type": "array", "items": {"type": "string"}, "description": "place id 引用"},
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["person", "role"],
        "properties": {
          "person": {"type": "string"},
          "role": {"type": "string", "description": "如 commander / general / instigator / victim"}
        },
        "additionalProperties": false
      }
    },
    "related_events": {"type": "array", "items": {"type": "string"}},
    "description": {"type": "string"},
    "outcome": {"type": "string"},
    "sources": {"type": "array", "minItems": 1},
    "_meta": {"type": "object"}
  },
  "additionalProperties": false
}
